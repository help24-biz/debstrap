#!/usr/bin/env bash
# Help24 - PHP webstack for vanilla Debian. No application or virtual host setup.
set -uo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
SCRIPT_DIR=${SCRIPT_PATH%/*}
if [[ ! -r "$SCRIPT_DIR/lib/common.sh" ]]; then
    printf 'ERROR: Missing library: %s/lib/common.sh\n' "$SCRIPT_DIR" >&2
    exit 1
fi
source "$SCRIPT_DIR/lib/common.sh"

webstack_help() {
    cat <<'HELP'
Usage: webstack_install install [options]
       webstack_install --help
       webstack_install                 (interactive menu)

  --profile general|nextcloud          Default: general
  --web nginx|apache|none               Default: nginx
  --php X.Y                            Default: Debian's PHP version
  --database mariadb|postgresql|none    Default: none
  --db-client auto|mariadb|postgresql|both|none  Default: auto
  --cache redis|none                   Default: redis
  --extras                            LDAP, IMAP, SOAP, BCMath, Imagick, GMP

PHP-FPM, CLI, common extensions, OPcache and APCu are always installed.
Auto clients: selected local database, or both clients when no local server.
Client selection does not change PHP database drivers.
Uses configured APT repositories; does not enable third-party repositories.
Does not create sites, TLS certificates, databases or install Nextcloud.
Redis and database services use the distribution's existing configuration.
HELP
}

webstack_parse() {
    PROFILE=general
    WEB=nginx
    PHP_VERSION=''
    DATABASE=none
    DB_CLIENT=auto
    CACHE=redis
    EXTRAS=0
    while (( $# )); do
        case "$1" in
            --profile|--web|--php|--database|--db-client|--cache)
                if (( $# < 2 )) || [[ "$2" == --* ]]; then
                    log_error "Missing value for $1"; return 2
                fi
                case "$1" in
                    --profile) PROFILE=$2 ;;
                    --web) WEB=$2 ;;
                    --php) PHP_VERSION=$2 ;;
                    --database) DATABASE=$2 ;;
                    --db-client) DB_CLIENT=$2 ;;
                    --cache) CACHE=$2 ;;
                esac
                shift 2 ;;
            --extras) EXTRAS=1; shift ;;
            *) log_error "Unknown option: $1"; return 2 ;;
        esac
    done
    case "$PROFILE" in general|nextcloud) ;; *) log_error 'Invalid profile'; return 2 ;; esac
    case "$WEB" in nginx|apache|none) ;; *) log_error 'Invalid web server'; return 2 ;; esac
    case "$DATABASE" in mariadb|postgresql|none) ;; *) log_error 'Invalid database'; return 2 ;; esac
    case "$DB_CLIENT" in auto|mariadb|postgresql|both|none) ;; *) log_error 'Invalid database client'; return 2 ;; esac
    case "$CACHE" in redis|none) ;; *) log_error 'Invalid cache'; return 2 ;; esac
    if [[ -n "$PHP_VERSION" && ! "$PHP_VERSION" =~ ^[0-9]+\.[0-9]+$ ]]; then
        log_error 'PHP version must use X.Y format'; return 2
    fi
}

webstack_preflight() {
    root_check || return 1
    platform_debian_check || return 1
    local cmd other
    for cmd in apt-get apt-cache dpkg-query systemctl; do
        command_check "$cmd" || { log_error "Missing command: $cmd"; return 1; }
    done
    # Do not install a second web server over an existing one.
    case "$WEB" in nginx) other=apache2 ;; apache) other=nginx ;; none) return 0 ;; esac
    if dpkg-query -W -f='${db:Status-Status}' "$other" 2>/dev/null | grep -qx installed; then
        log_error "$other is installed; select it or use --web none"
        return 1
    fi
}

webstack_packages() {
    local module client=$DB_CLIENT
    PACKAGES=(ca-certificates unzip curl)
    PHP_MODULES=(fpm cli common curl gd intl mbstring xml zip opcache apcu)
    if [[ "$PROFILE" == nextcloud || "$EXTRAS" == 1 ]]; then
        PHP_MODULES+=(bcmath gmp imagick)
    fi
    if [[ "$EXTRAS" == 1 ]]; then PHP_MODULES+=(ldap imap soap); fi
    case "$DATABASE" in
        mariadb) PACKAGES+=(mariadb-server); PHP_MODULES+=(mysql) ;;
        postgresql) PACKAGES+=(postgresql); PHP_MODULES+=(pgsql) ;;
        none) PHP_MODULES+=(mysql pgsql sqlite3) ;;
    esac
    # Remote databases need command-line clients too (backup/restore/admin).
    if [[ "$client" == auto ]]; then
        client=$DATABASE
        [[ "$client" != none ]] || client=both
    fi
    case "$client" in
        mariadb) PACKAGES+=(mariadb-client) ;;
        postgresql) PACKAGES+=(postgresql-client) ;;
        both) PACKAGES+=(mariadb-client postgresql-client) ;;
    esac
    if [[ "$CACHE" == redis ]]; then
        PACKAGES+=(redis-server)
        PHP_MODULES+=(redis)
    fi
    case "$WEB" in nginx) PACKAGES+=(nginx) ;; apache) PACKAGES+=(apache2) ;; esac
    for module in "${PHP_MODULES[@]}"; do PACKAGES+=("php${PHP_VERSION}-${module}"); done
}

webstack_php_configure() {
    local config="/etc/php/$PHP_VERSION/mods-available/help24-webstack.ini"
    # Only our own INI file is managed. Keep php.ini and FPM pools intact.
    cat > "$config" <<'INI' || return 1
; Managed by Help24 webstack_install
expose_php = Off
opcache.enable = 1
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 10000
opcache.validate_timestamps = 1
apc.shm_size = 64M
apc.enable_cli = 1
INI
    if [[ "$PROFILE" == nextcloud ]]; then
        cat >> "$config" <<'INI' || return 1
memory_limit = 512M
upload_max_filesize = 512M
post_max_size = 512M
max_execution_time = 360
INI
    fi
    chmod 0644 "$config" || return 1
    phpenmod -v "$PHP_VERSION" -s fpm help24-webstack || return 1
    phpenmod -v "$PHP_VERSION" -s cli help24-webstack || return 1
    "php-fpm${PHP_VERSION}" -t || return 1
    systemctl enable --now "php${PHP_VERSION}-fpm" || return 1
    systemctl reload "php${PHP_VERSION}-fpm"
}

webstack_services() {
    case "$DATABASE" in
        mariadb) systemctl enable --now mariadb || return 1 ;;
        postgresql) systemctl enable --now postgresql || return 1 ;;
    esac
    if [[ "$CACHE" == redis ]]; then systemctl enable --now redis-server || return 1; fi
    case "$WEB" in
        nginx)
            nginx -t || return 1
            systemctl enable --now nginx || return 1 ;;
        apache)
            a2enmod proxy_fcgi setenvif || return 1
            a2enconf "php${PHP_VERSION}-fpm" || return 1
            apache2ctl configtest || return 1
            systemctl enable --now apache2 || return 1
            systemctl reload apache2 || return 1 ;;
    esac
}

webstack_install() {
    webstack_parse "$@" || return
    webstack_preflight || return 1
    apt-get update || return 1
    if [[ -z "$PHP_VERSION" ]]; then
        # Read the version selected by Debian's php-fpm metapackage.
        PHP_VERSION=$(apt-cache depends php-fpm | sed -nE 's/^[[:space:]]*Depends: php([0-9]+\.[0-9]+)-fpm$/\1/p')
        [[ "$PHP_VERSION" =~ ^[0-9]+\.[0-9]+$ ]] || {
            log_error 'Cannot determine PHP version; use --php X.Y'; return 1
        }
    fi
    if [[ "$PROFILE" == nextcloud ]]; then
        case "$PHP_VERSION" in
            8.3|8.4|8.5) ;;
            *) log_error 'Nextcloud profile requires PHP 8.3, 8.4 or 8.5; select a version available in your repositories'; return 2 ;;
        esac
    fi
    webstack_packages
    log_info "Installing $PROFILE: web=$WEB PHP=$PHP_VERSION database=$DATABASE client=$DB_CLIENT cache=$CACHE"
    # Resolve everything before installing; unavailable extensions fail here.
    apt-get --simulate install --no-install-recommends "${PACKAGES[@]}" || return 1
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${PACKAGES[@]}" || return 1
    webstack_php_configure || return 1
    webstack_services || return 1
    log_info "Webstack installed. PHP-FPM socket: /run/php/php${PHP_VERSION}-fpm.sock"
    log_info 'Configure each site, TLS and application database separately.'
    if [[ "$WEB" == nginx ]]; then
        log_info 'Nginx sites must explicitly forward PHP requests to the FPM socket.'
    fi
    if [[ "$PROFILE" == nextcloud ]]; then
        log_info 'Nextcloud: configure APCu in config.php; configure Redis for locking when available.'
        log_info 'Align web server upload/time limits and configure the Nextcloud cron job.'
    fi
}

webstack_menu() {
    local profile web php database client cache extras
    while true; do
        printf '\nHelp24 Webstack\n 1) General PHP / hosting\n 2) Nextcloud prerequisites\n 0) Exit\n'
        read -r -p 'Selection: ' profile || return 0
        case "$profile" in
            0) return 0 ;;
            1) profile=general ;;
            2) profile=nextcloud ;;
            *) log_warn 'Invalid selection'; continue ;;
        esac
        read -r -p 'Web server [nginx/apache/none] (nginx): ' web || return 0
        read -r -p 'PHP version [X.Y, empty = Debian default]: ' php || return 0
        read -r -p 'Local database [mariadb/postgresql/none] (none): ' database || return 0
        read -r -p 'Database CLI client [auto/mariadb/postgresql/both/none] (auto): ' client || return 0
        read -r -p 'Cache server [redis/none] (redis): ' cache || return 0
        read -r -p 'Extra PHP extensions [y/N]: ' extras || return 0
        local args=(--profile "$profile" --web "${web:-nginx}" --database "${database:-none}" --db-client "${client:-auto}" --cache "${cache:-redis}")
        [[ -z "$php" ]] || args+=(--php "$php")
        case "$extras" in y|Y) args+=(--extras) ;; esac
        if ! webstack_install "${args[@]}"; then log_error 'Webstack installation failed'; fi
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1:-}" in
        '') webstack_menu ;;
        --help|-h) webstack_help ;;
        install) shift; webstack_install "$@" ;;
        *) webstack_help >&2; exit 2 ;;
    esac
fi
