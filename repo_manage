#!/usr/bin/env bash
# Manage upstream repositories on vanilla Debian 12/13.
set -uo pipefail

# Resolve the installed /usr/local/bin symlink before loading the library.
SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
SCRIPT_DIR=${SCRIPT_PATH%/*}
if [[ ! -r "$SCRIPT_DIR/lib/common.sh" ]]; then
  printf 'ERROR: Missing library: %s/lib/common.sh\n' "$SCRIPT_DIR" >&2
  exit 1
fi
source "$SCRIPT_DIR/lib/common.sh"

REPO_DIR=/etc/apt/sources.list.d
KEY_DIR=/etc/apt/keyrings

repo_preflight() {
  root_check || return 1
  platform_debian_check || return 1
  local cmd
  for cmd in apt-get dpkg curl sha256sum; do
    command_check "$cmd" || {
      log_error "Required command missing: $cmd (run debian_bootstrap first)"
      return 1
    }
  done
  install -d -m 0755 "$REPO_DIR" "$KEY_DIR"
}

repo_download() {
  curl --fail --silent --show-error --location --proto '=https' "$1" -o "$2"
}

# Install only complete files; failed downloads leave existing files intact.
repo_file_write() {
  local file=$1 tmp
  tmp=$(mktemp) || return 1
  if ! cat > "$tmp" || ! install -m 0644 "$tmp" "$file"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
}

repo_conflict_check() {
  local pattern=$1 own_file=$2 file
  for file in /etc/apt/sources.list "$REPO_DIR"/*.list "$REPO_DIR"/*.sources; do
    [[ -f "$file" && "$file" != "$own_file" ]] || continue
    if grep -Ei '^[[:space:]]*[^#[:space:]]' "$file" | grep -Eq "$pattern"; then
      log_error "Repository already present in $file; review it before enabling"
      return 1
    fi
  done
}

repo_key_refresh() {
  local url=$1 file=$2 tmp
  tmp=$(mktemp) || return 1
  if ! repo_download "$url" "$tmp" || [[ ! -s "$tmp" ]] ||
      ! install -m 0644 "$tmp" "$file"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
}

repo_sury_key_refresh() {
  local tmp
  tmp=$(mktemp) || return 1
  if ! repo_download 'https://packages.sury.org/debsuryorg-archive-keyring.deb' "$tmp" ||
      ! dpkg -i "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
}

repo_sury_enable() {
  local file="$REPO_DIR/help24-sury.sources"
  repo_conflict_check 'packages\.sury\.org/php' "$file" || return 1
  repo_sury_key_refresh || return 1
  repo_file_write "$file" <<EOF
Types: deb
URIs: https://packages.sury.org/php/
Suites: $HELP24_OS_CODENAME
Components: main
Signed-By: /usr/share/keyrings/debsuryorg-archive-keyring.gpg
EOF
}

repo_nginx_key_refresh() {
  repo_key_refresh 'https://nginx.org/keys/nginx_signing.key' "$KEY_DIR/help24-nginx.asc"
}

repo_nginx_enable() {
  local channel=${1:-stable} uri file="$REPO_DIR/help24-nginx.sources"
  case "$channel" in
    stable) uri=https://nginx.org/packages/debian ;;
    mainline) uri=https://nginx.org/packages/mainline/debian ;;
    *) log_error "Unknown Nginx channel: $channel"; return 2 ;;
  esac
  repo_conflict_check 'nginx\.org/packages' "$file" || return 1
  repo_nginx_key_refresh || return 1
  repo_file_write "$file" <<EOF
Types: deb
URIs: $uri
Suites: $HELP24_OS_CODENAME
Components: nginx
Signed-By: $KEY_DIR/help24-nginx.asc
EOF
}

repo_postgresql_key_refresh() {
  repo_key_refresh 'https://www.postgresql.org/media/keys/ACCC4CF8.asc' "$KEY_DIR/help24-pgdg.asc"
}

repo_postgresql_enable() {
  local file="$REPO_DIR/help24-pgdg.sources" arch
  repo_conflict_check 'apt\.postgresql\.org' "$file" || return 1
  arch=$(dpkg --print-architecture)
  case "$arch" in
    amd64|arm64|ppc64el) ;;
    *) log_error "Unsupported PGDG architecture: $arch"; return 1 ;;
  esac
  repo_postgresql_key_refresh || return 1
  repo_file_write "$file" <<EOF2
Types: deb
URIs: https://apt.postgresql.org/pub/repos/apt
Suites: ${HELP24_OS_CODENAME}-pgdg
Components: main
Architectures: $arch
Signed-By: $KEY_DIR/help24-pgdg.asc
EOF2
}
# MariaDB uses a changing vendor installer. Do not run an unverified remote
# script. Supply the vendor-published SHA-256 for the exact downloaded version.
repo_mariadb_enable() {
  local version=${1:-} checksum=${2:-} tmp
  [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]] || {
    log_error 'Specify MariaDB version (e.g. 11.4)'; return 2;
  }
  [[ "$checksum" =~ ^[[:xdigit:]]{64}$ ]] || {
    log_error 'Supply the official 64-character SHA-256 of mariadb_repo_setup'; return 2;
  }
  repo_conflict_check '(mariadb\.com|mariadb\.org|dlm\.mariadb\.com)' \
    '/nonexistent/help24-mariadb.sources' || return 1
  tmp=$(mktemp) || return 1
  if ! repo_download 'https://r.mariadb.com/downloads/mariadb_repo_setup' "$tmp"; then
    rm -f "$tmp"; return 1
  fi
  if ! printf '%s  %s\n' "$checksum" "$tmp" | sha256sum -c --status; then
    rm -f "$tmp"; log_error 'MariaDB installer SHA-256 mismatch'; return 1
  fi
  log_info "Verified MariaDB installer; configuring version $version"
  if ! bash "$tmp" --mariadb-server-version="mariadb-$version" \
      --skip-maxscale --skip-tools; then
    rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"
  log_info 'MariaDB vendor installer completed; review APT changes before update'
}
repo_check() {
  local name=$1 file=''
  case "$name" in
    sury) file="$REPO_DIR/help24-sury.sources" ;;
    nginx) file="$REPO_DIR/help24-nginx.sources" ;;
    postgresql) file="$REPO_DIR/help24-pgdg.sources" ;;
    mariadb)
      log_info 'MariaDB APT source files:'
      local files=()
      shopt -s nullglob
      files+=("$REPO_DIR"/*.list "$REPO_DIR"/*.sources)
      shopt -u nullglob
      if (( ${#files[@]} )); then
        grep -lEi '(mariadb\.com|mariadb\.org|dlm\.mariadb\.com)' "${files[@]}" || true
      fi
      return 0 ;;
    *) log_error "Unknown repo: $name"; return 2 ;;
  esac
  if [[ -f "$file" ]]; then
    log_info "$name configured: $file"
    cat "$file"
  else
    log_warn "$name not configured by Help24"
  fi
}
repo_update() { log_info 'Updating APT package indexes'; apt-get update; }
repo_manage() {
  local name=${1:-} action=${2:-} arg=${3:-} extra=${4:-} item
  case "$name:$action" in
    sury:enable) repo_sury_enable ;;
    sury:key-refresh) repo_sury_key_refresh ;;
    nginx:enable) repo_nginx_enable "${arg:-stable}" ;;
    nginx:key-refresh) repo_nginx_key_refresh ;;
    postgresql:enable) repo_postgresql_enable ;;
    postgresql:key-refresh) repo_postgresql_key_refresh ;;
    mariadb:enable) repo_mariadb_enable "$arg" "$extra" ;;
    mariadb:key-refresh)
      log_error 'MariaDB keys are vendor-managed; rerun verified setup'; return 2 ;;
    all:check)
      for item in sury nginx mariadb postgresql; do repo_check "$item" || return; done ;;
    all:update) repo_update ;;
    sury:check|nginx:check|mariadb:check|postgresql:check) repo_check "$name" ;;
    *) log_error "Unsupported operation: $name $action"; return 2 ;;
  esac
}
repo_menu() {
  local choice version checksum
  while true; do
    cat <<'MENU'
Help24 - Debian Repo Management
 1) Enable Sury PHP
 2) Enable Nginx stable
 3) Enable Nginx mainline
 4) Enable MariaDB (version + official SHA-256)
 5) Enable PostgreSQL PGDG
 6) Check repos
 7) Refresh Sury keyring
 8) Refresh Nginx key
 9) Refresh PostgreSQL key
10) Update APT indexes
 0) Exit
MENU
    read -r -p 'Selection: ' choice || return 0
    case "$choice" in
      1) repo_manage sury enable ;;
      2) repo_manage nginx enable stable ;;
      3) repo_manage nginx enable mainline ;;
      4)
        read -r -p 'MariaDB version (e.g. 11.4): ' version || return 0
        read -r -p 'Official setup SHA-256: ' checksum || return 0
        repo_manage mariadb enable "$version" "$checksum" ;;
      5) repo_manage postgresql enable ;;
      6) repo_manage all check ;;
      7) repo_manage sury key-refresh ;;
      8) repo_manage nginx key-refresh ;;
      9) repo_manage postgresql key-refresh ;;
      10) repo_manage all update ;;
      0) return 0 ;;
      *) log_warn 'Invalid selection' ;;
    esac
  done
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  repo_preflight || exit 1
  if (( $# == 0 )); then repo_menu; else repo_manage "$@"; fi
fi
